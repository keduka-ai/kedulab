# Copy to a per-project env file (e.g. .env.nlp) and load with
# `docker compose --env-file .env.nlp -p nlp up -d --build`.
# Use `-p <name>` to namespace each stack so multiple can run in parallel.

# Requirements file installed into the venv at build time.
# Add new files alongside requirements.txt (e.g. requirements-nlp.txt) for
# per-project deps. jupyterlab + ipykernel are always installed via
# jupyter-base.txt, so this file should hold project deps only.
REQUIREMENTS_FILE=requirements.txt

# Python version uv installs into the venv at /opt/venv.
PYTHON_VERSION=3.12

# Non-root container user UID/GID. The image creates user `jovyan` with
# these IDs. Match to your host user (`id -u` / `id -g`) so files written
# into MOUNT_PATH from inside the container are owned by your host user.
USER_UID=1000
USER_GID=1000

# Host directory mounted to /home/workspace inside the container.
# Notebooks, data, and outputs all live here.
MOUNT_PATH=./workspace

# Host port mapped to JupyterLab on container port 5678.
# Must be unique across concurrently running stacks.
HOST_PORT=8888

# Host interface to bind on. Default 127.0.0.1 keeps JupyterLab reachable
# only from the host itself — JupyterLab on a public bind is arbitrary
# code execution. Override to 0.0.0.0 ONLY when running behind a real
# auth proxy on a trusted network.
BIND_ADDR=127.0.0.1

# Resource limits — guard against runaway notebooks OOMing the host.
MEMORY_LIMIT=16G
CPU_LIMIT=8

# Shared-memory size. Default /dev/shm is 64 MB; PyTorch DataLoader workers
# crash with "DataLoader worker is killed" at scale unless this is raised.
SHM_SIZE=2gb

# uv version copied from ghcr.io/astral-sh/uv at build time. Bump to upgrade
# the resolver / installer. See https://github.com/astral-sh/uv/releases.
UV_VERSION=0.5.11

# JupyterLab auth — leave blank for auto-token (printed in `docker logs`).
# REQUIRED if BIND_ADDR != 127.0.0.1. Generate with:
#   python -c "from jupyter_server.auth import passwd; print(passwd())"
JUPYTER_PASSWORD_HASH=

# Build-time CVE gate. Set to 1 in CI to fail the build on any pip-audit
# finding. Leave 0 for iterative local rebuilds.
PIP_AUDIT_STRICT=0
