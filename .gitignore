# Env files (never commit secrets); template is tracked
.env
.env.*
!.env.example

# Credentials / keys
*.pem
*.key
*.crt
secrets/

# Shell installers that historically lived in the repo root
Miniconda3-*.sh
*-installer.sh

# IDE / editor state
.idea/
.vscode/
*.swp

# OS cruft
.DS_Store
Thumbs.db

# Python bytecode / test cache
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# Host-side virtualenvs (the container venv lives at /opt/venv, not in-repo)
.venv/
venv/

# Linter / type-checker / coverage caches
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ML model / weight artifacts
*.h5
*.hdf5
*.ckpt
*.pt
*.pth
*.onnx
*.safetensors
*.gguf
*.pkl
*.joblib
*.npy
*.npz

# Datasets / downloaded corpora caches
.cache/
nltk_data/

# Training / experiment logs
*.log
logs/
runs/
*.tfevents.*
wandb/
mlruns/
lightning_logs/

# Python packaging output
build/
dist/
*.whl

# uv lockfile cache scratch
.uv-cache/

# Jupyter runtime artifacts
.ipynb_checkpoints/
*-checkpoint.ipynb
.jupyter/

# Workspace bind-mount target — user notebooks/data, never commit
workspace/*
!workspace/.gitkeep

# Trash dirs created by file managers / Jupyter delete
.Trash-*/

# Local Claude state
.claude/
.docs/
CLAUDE.md

# install.sh smoke-test scratch
.smoketest/

# NOT ignored, deliberately:
#   CHANGELOG.md / RELEASE_NOTES.md — a published repo needs a changelog, and
#     SECURITY.md points at the release notes for the install.sh checksum.
#   requirements*.lock — lockfiles are the reproducible-build artifact and are
#     meant to be committed alongside the .txt they were compiled from
#     (scripts/lock.sh -a).
